{
  "schema_version": "1.0.0",
  "metadata": {
    "id": "national",
    "name": "National (Jatiya)",
    "version": "1.0.0",
    "standard": "BCC Baseline / xkeyboard-config symbols/bd basic",
    "author": "Bangladesh Computer Council / Jamil Ahmed",
    "description": "Standard National (Jatiya) keyboard layout for Bengali",
    "supported_layers": [
      "Normal",
      "Shift",
      "AltGr"
    ]
  },
  "rules": {
    "link_key": "KeyG",
    "supports_link_vowel_composition": true,
    "link_vowel_map": {
      "া": "আ",
      "ি": "ই",
      "ী": "ঈ",
      "ু": "উ",
      "ূ": "ঊ",
      "ৃ": "ঋ",
      "ে": "এ",
      "ৈ": "ঐ",
      "ো": "ও",
      "ৌ": "ঔ"
    }
  },
  "keys": {
    "Backquote": {
      "unshifted": "`",
      "shifted": "~",
      "altgr": null
    },
    "Digit1": {
      "unshifted": "১",
      "shifted": "!",
      "altgr": null
    },
    "Digit2": {
      "unshifted": "২",
      "shifted": "@",
      "altgr": null
    },
    "Digit3": {
      "unshifted": "৩",
      "shifted": "#",
      "altgr": null
    },
    "Digit4": {
      "unshifted": "৪",
      "shifted": "৳",
      "altgr": "$"
    },
    "Digit5": {
      "unshifted": "৫",
      "shifted": "%",
      "altgr": null
    },
    "Digit6": {
      "unshifted": "৬",
      "shifted": "^",
      "altgr": null
    },
    "Digit7": {
      "unshifted": "৭",
      "shifted": "ঁ",
      "altgr": "&"
    },
    "Digit8": {
      "unshifted": "৮",
      "shifted": "*",
      "altgr": null
    },
    "Digit9": {
      "unshifted": "৯",
      "shifted": "(",
      "altgr": null
    },
    "Digit0": {
      "unshifted": "০",
      "shifted": ")",
      "altgr": null
    },
    "Minus": {
      "unshifted": "-",
      "shifted": "_",
      "altgr": null
    },
    "Equal": {
      "unshifted": "=",
      "shifted": "+",
      "altgr": "॥"
    },
    "KeyQ": {
      "unshifted": "ঙ",
      "shifted": "ং",
      "altgr": null
    },
    "KeyW": {
      "unshifted": "য",
      "shifted": "য়",
      "altgr": null
    },
    "KeyE": {
      "unshifted": "ড",
      "shifted": "ঢ",
      "altgr": null
