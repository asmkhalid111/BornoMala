      "shifted": "ল",
      "altgr": null
    },
    "KeyB": {
      "unshifted": "ন",
      "shifted": "ণ",
      "altgr": null
    },
    "KeyN": {
      "unshifted": "ম",
      "shifted": "ণ",
      "altgr": null
    },
    "KeyM": {
      "unshifted": "ল",
      "shifted": "শ",
      "altgr": null
    },
    "Comma": {
      "unshifted": ",",
      "shifted": "<",
      "altgr": null
    },
    "Period": {
      "unshifted": ".",
      "shifted": "।",
      "altgr": null
    },
    "Slash": {
      "unshifted": "/",
      "shifted": "?",
      "altgr": null
    },
    "Space": {
      "unshifted": " ",
      "shifted": " ",
      "altgr": null
    }
